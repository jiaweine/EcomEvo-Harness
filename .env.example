# 外部/自托管 AI 服务均为可选；未配置时仍可使用本地受控模式跑通文本与结构化业务流程。
ECOMEVO_DATA=outputs/runtime

# Release Readiness 的部署拓扑声明。当前 SQLite/WAL durable control plane 只认证单应用节点，
# 同一节点可以运行多个 worker 进程。未声明会让发布准备度 fail closed；
# 显式空值、非法值或 >1 还会让 Runtime 在打开业务数据库/启动 worker 前直接拒绝启动。
# 这只是部署方声明，不是 Kubernetes/容器副本自动发现；真正多节点前必须迁移集中式事务存储/队列。
ECOMEVO_DEPLOYMENT_NODES=1

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 阿里云百炼 / 通义千问
DASHSCOPE_API_KEY=
QWEN_MODEL=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 火山引擎方舟 / 豆包
ARK_API_KEY=
DOUBAO_MODEL=
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# Moonshot AI / Kimi
MOONSHOT_API_KEY=
KIMI_MODEL=
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MULTIMODAL=1

# 智谱 AI / GLM
ZHIPU_API_KEY=
ZHIPU_MODEL=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# 仅当所选 GLM 模型实际支持视觉输入时开启。
ZHIPU_MULTIMODAL=0

# 腾讯云 TokenHub / 混元。默认使用中国大陆广州统一 OpenAI-Compatible 入口。
# 国际部署可显式覆盖 HUNYUAN_BASE_URL，例如新加坡 TokenHub 国际入口。
TENCENT_TOKENHUB_API_KEY=
HUNYUAN_MODEL=
HUNYUAN_BASE_URL=https://tokenhub.tencentcloudmaas.com/v1
HUNYUAN_MULTIMODAL=1

# 百度智能云千帆 / 文心及兼容模型
QIANFAN_API_KEY=
QIANFAN_MODEL=
QIANFAN_BASE_URL=https://qianfan.baidubce.com/v2
# 仅当所选千帆模型实际支持视觉输入时开启。
QIANFAN_MULTIMODAL=0

# 可选：当前开源权重 / 自托管 OpenAI-Compatible 推理服务。
# 模型名完全由部署方配置，升级模型无需修改 EcomEvo 代码。
OPEN_MODEL_BASE_URL=
OPEN_MODEL_API_KEY=
OPEN_MODEL_MODEL=
OPEN_MODEL_MULTIMODAL=0

# 可选：企业自建 OpenAI-Compatible 模型服务。
CUSTOM_BASE_URL=
CUSTOM_API_KEY=
CUSTOM_MODEL=
CUSTOM_MULTIMODAL=1

# 自主 Runtime 的硬上限仍由代码控制；这些值只在允许范围内调节探索强度。
ECOMEVO_AUTONOMY_STEPS=6
ECOMEVO_AUTONOMY_CALLS_PER_STEP=4
ECOMEVO_AUTONOMY_DELEGATIONS_PER_STEP=3

# 最终回答的 claim-level grounding。默认开启：模型生成的业务文本只作为候选，
# 系统会拆分用户子问题与原子声明，核对 evidence_id、日期、金额、比例和业务标识，
# 无法直接核验或与证据冲突的事实性表述不会进入最终回答。
# 仅用于隔离额外模型调用的延迟/成本实验时才建议临时关闭；关闭不会削弱 Runtime/Verifier/Approval 的确定性权限门禁。
ECOMEVO_CLAIM_GROUNDING=1

# Evidence Search 默认完全本地运行 exact + contextual BM25 + RRF + MMR；不会因为启用检索而访问公网。
# 如果企业显式配置 OpenAI-Compatible embeddings 服务，则额外加入 dense retrieval 通道后再做 RRF 融合。
# 建议优先填企业内网/自托管 embedding endpoint；向量服务异常会自动回退到本地通道，不影响 Verifier/Governance。
ECOMEVO_RETRIEVAL_EMBEDDING_BASE_URL=
ECOMEVO_RETRIEVAL_EMBEDDING_API_KEY=
ECOMEVO_RETRIEVAL_EMBEDDING_MODEL=
ECOMEVO_RETRIEVAL_EMBEDDING_TIMEOUT=12

# 可选二阶段 neural reranker。URL 直接指向兼容 {model,query,documents,top_n} 的 rerank endpoint；
# 推荐企业内网/自托管 cross-encoder 或 late-interaction reranker。未配置时完全不调用；超时或返回不完整会保留原 hybrid 排名。
# 原 hybrid 排名和 reranker 排名会通过 RRF 再融合，不会直接把神经模型 raw score 当成最终排序权威。
ECOMEVO_RETRIEVAL_RERANK_URL=
ECOMEVO_RETRIEVAL_RERANK_API_KEY=
ECOMEVO_RETRIEVAL_RERANK_MODEL=
ECOMEVO_RETRIEVAL_RERANK_TIMEOUT=10

# Engine 级只读工具背压。timeout 覆盖 semaphore 排队 + 实际执行，避免高并发 fan-out 放大尾延迟。
# 代码会再次 clamp：timeout 2..120 秒，max inflight 1..64；非法值回退到 25 秒 / 16 并发。
ECOMEVO_TOOL_TIMEOUT_SECONDS=25
ECOMEVO_TOOL_MAX_INFLIGHT=16

# MCP transport 的单请求超时，作用于企业只读数据和人工确认后的业务执行。
# 代码 clamp 为 3..120 秒；任何 transport timeout 在高影响动作路径都按“结果待核对”处理，不自动重试。
ECOMEVO_MCP_TIMEOUT_SECONDS=30

# Durable conversation worker：消息接收后，输入快照和 job 会先落 SQLite；BackgroundTasks 仅作低延迟触发。
# worker/process 崩溃时，其他 worker 可在 lease 到期后重新 claim 同一个持久 job。
# poll clamp 0.25..10 秒；job lease clamp 60..600 秒。
ECOMEVO_JOB_POLL_SECONDS=1
ECOMEVO_JOB_LEASE_SECONDS=120

# WebSocket 除进程内低延迟 queue 外，会按 event id 从 SQLite durable log 补拉跨 worker 事件。
# 默认 2 秒，代码 clamp 为 0.5..15 秒；心跳仍保持低频，不随补拉频率放大。
ECOMEVO_WS_POLL_SECONDS=2

# 身份/RBAC。
# local 只适合本地开发或已经由外层网络完全隔离的演示环境；默认 local-admin 拥有 admin 权限。
ECOMEVO_AUTH_MODE=local
ECOMEVO_LOCAL_TENANT=local
ECOMEVO_LOCAL_USER=local-admin
ECOMEVO_LOCAL_ROLE=admin

# 生产建议在企业 SSO / API Gateway / 可信反向代理之后切换为 hmac：
# ECOMEVO_AUTH_MODE=hmac
# ECOMEVO_AUTH_HMAC_SECRET=<至少 32 字节的服务端密钥>
# 代理在每个 /api 和 /ws 请求上签入 X-EcomEvo-Tenant/User/Role/Timestamp/Signature。
# HMAC secret 只能存在于服务端/可信代理，绝不能下发到浏览器。
ECOMEVO_AUTH_HMAC_SECRET=
ECOMEVO_AUTH_MAX_SKEW_SECONDS=300

# 可选 MCP 连接。示例：
# ECOMEVO_MCP_SERVERS=[{"key":"oms","name":"订单中心","url":"https://internal.example/mcp","token_env":"OMS_MCP_TOKEN"}]
ECOMEVO_MCP_SERVERS=

# 可选：给 Data Connections 控制面显式声明连接的证据 authority / freshness。
# 这些值只用于可观察性和证据来源解释，绝不能提升 Governance / Approval / BusinessAction 权限。
# authority 允许：authoritative_internal | controlled_knowledge | submitted_evidence | external_public | unknown
# freshness 允许：live | cached | unknown；非法或缺失值一律显示 unknown。
# ECOMEVO_MCP_CONNECTION_META={"oms":{"authority":"authoritative_internal","freshness":"live"}}
ECOMEVO_MCP_CONNECTION_META=

# 默认仅同源访问；前后端分离部署时显式填写允许的浏览器来源，逗号分隔。
ECOMEVO_CORS_ORIGINS=

# 可选：把业务动作映射到 MCP 工具。${action_id} 可作为下游幂等键。
# ECOMEVO_ACTION_MCP_MAP={"merchant.review":{"server":"merchant-core","tool":"submit_review","arguments":{"action_id":"${action_id}","conversation_id":"${conversation_id}"}}}
ECOMEVO_ACTION_MCP_MAP=

# 可选：把只读企业工具加入任务核对链。evidence_tags 只给可信内部工具配置。
# ECOMEVO_MCP_READ_TOOLS=[{"key":"mcp.merchant.profile","domain":"merchant_review","server":"merchant-core","tool":"get_profile","purpose":"读取商家主体信息","arguments":{"query":"${text}"},"evidence_tags":["merchant_identity"],"cost":1.0}]
ECOMEVO_MCP_READ_TOOLS=
